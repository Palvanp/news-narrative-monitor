# Database: SQLite for now. For Postgres + pgvector (docker compose up -d db):
# DATABASE_URL=postgresql+psycopg://nazar:nazar@localhost:5432/nazar
DATABASE_URL=sqlite:///data/nazar.db

# Keep NLP models loaded between runs (faster; holds ~2.5 GB GPU memory)
KEEP_MODELS_LOADED=true

# News sources, comma-separated: rss, gdelt
NEWS_SOURCES=rss

# LLM provider: groq (hosted API, default) or ollama (self-hosted)
LLM_PROVIDER=groq
# Free key from https://console.groq.com/keys. Never commit it.
GROQ_API_KEY=
# Brief prompts are trimmed to this many tokens (Groq free tier: ~8K tokens/minute)
GROQ_MAX_PROMPT_TOKENS=4500

# Ollama alternative (LLM_PROVIDER=ollama), e.g. through an SSH tunnel to a VM:
#   ssh -i key.pem -N -L 11434:localhost:11434 ubuntu@<vm-ip>
OLLAMA_URL=http://127.0.0.1:11434
LLM_TIMEOUT_SECONDS=600

# Models. Leave empty for the provider's defaults:
#   groq:   openai/gpt-oss-120b (naming and brief)
#   ollama: qwen2.5:3b-instruct (naming), qwen2.5:7b-instruct (brief)
LLM_NAMING_MODEL=
LLM_BRIEF_MODEL=

# NLP models (run locally; DEVICE=auto picks cuda when available)
DEVICE=auto
EMBEDDING_MODEL=BAAI/bge-m3
SENTIMENT_MODEL=cardiffnlp/twitter-xlm-roberta-base-sentiment
HINDI_NER_MODEL=cfilt/HiNER-collapsed-muril-base-cased
HINDI_NER_TOKENIZER=google/muril-base-cased
